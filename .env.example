# ==============================================================================
# MYlog — Operational Energy & Cost Monitoring (Agranusa Signature Villa)
# Environment Variables Example
# ==============================================================================

# ------------------------------------------------------------------------------
# METODE 1 (PALING MUDAH & GRATIS): GOOGLE APPS SCRIPT WEB APP
# Buat dari menu Ekstensi -> Apps Script di Google Sheet Anda
# ------------------------------------------------------------------------------
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/AKfycb.../exec"

# ------------------------------------------------------------------------------
# METODE 2 (OPSIONAL): GOOGLE CLOUD SERVICE ACCOUNT (Sheets API v4)
# ------------------------------------------------------------------------------
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# URL Produksi Aplikasi
NEXT_PUBLIC_APP_URL="https://mylog.vercel.app"
APP_ENV="production"
